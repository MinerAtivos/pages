# para_tabela
tabela_VALE3b=subset(para_tabela,ativo==at)
tabela_VALE3b$CodigoIdentificadorNegocio = row_number(tabela_VALE3b)
tabela_VALE3b$outlier = ifelse((tabela_VALE3b$CodigoIdentificadorNegocio==subset(tabela_VALE3b, hora==tabela_VALE3$hora.x)[,"CodigoIdentificadorNegocio"]),1,0)
ymin = ifelse(min(tabela_VALE3b$Close)-1<0,yes = 0,min(tabela_VALE3b$Close)-1)
dif = (max(tabela_VALE3$High.x)- ymin)
# Calcula os máximos antes de criar o gráfico
max_vol <- max(tabela_VALE3b$Volume, na.rm = TRUE)
max_close <- max(tabela_VALE3b$Close, na.rm = TRUE)
min_close <- min(tabela_VALE3b$Close, na.rm = TRUE)
tabela_VALE3b$volumeR = (scale(x = tabela_VALE3b$Volume, center = min(subset(tabela_VALE3b, Volume>0)$Volume), scale = (max(tabela_VALE3b$Volume)-min(subset(tabela_VALE3b, Volume>0)$Volume))))
tabela_VALE3b$volumeR2 =  (tabela_VALE3b$Volume / max_vol * (max_close - min_close) + min_close)#tabela_VALE3b$Close * (tabela_VALE3b$volumeR)
tabela_VALE3b$volumeR2Medio =  mean(tabela_VALE3b$volumeR2)
# Criando uma coluna de variação percentual
tabela_VALE3b$delta <- Delt(tabela_VALE3b$Close, k = 1)
tabela_VALE3b[is.na(tabela_VALE3b)] = 0
largura_coluna = 5 / nrow(tabela_VALE3b)  # ajuste esse 5 conforme o espaçamento desejado
# Definindo as cores com base na variação
tabela_VALE3b$cor <- ifelse(tabela_VALE3b$delta > 0, "olivedrab1",
ifelse(tabela_VALE3b$delta < 0, "gray75", "gray"))
# Calcula a média móvel com janela de 10 períodos
tabela_VALE3b$media_movel <- rollmean(tabela_VALE3b$Close, k = nrow(tabela_VALE3b)/10, fill = NA, align = "right")
sum(is.na(tabela_VALE3b$Open))
sum(is.na(tabela_VALE3b$Close))
sum(is.na(tabela_VALE3b$High))
sum(is.na(tabela_VALE3b$Low))
largura_coluna_candlestick <- 0.6 / nrow(tabela_VALE3b)
index = 1:nrow(tabela_VALE3b)
# teste inclui fibonacci
# Pegar últimos 100 candles
dados <- tabela_VALE3b[, 4:8]
# Calcular fundo e topo do período
preco_fundo <- min(Lo(tail(dados,100)))
preco_topo  <- max(Hi(tail(dados,100)))
# Calcular níveis de retração
niveis <- c(0.236, 0.382, 0.5, 0.618, 0.786)
retracoes <- preco_topo - (preco_topo - preco_fundo) * niveis
names(retracoes) <- paste0("Fibo_", niveis * 100, "%")
# Preço atual e tolerância
preco_atual <- as.numeric(Cl(last(dados)))
margem <- 0.01  # 1%
proximos <- abs(preco_atual - retracoes) / preco_atual <= margem
# Criar objetos xts com NA nas primeiras 50 linhas
for (i in seq_along(retracoes)) {
nivel <- retracoes[i]
nome_obj <- gsub("%", "", names(retracoes)[i]) # Ex: "Fibo_78.6"
# vetor com NA nas primeiras 50 posições, e o valor do nível depois
vet <- c(rep(NA, nrow(dados) - 50), rep(nivel, 50))
# criar o objeto xts
assign(nome_obj, data.frame(vet, order.by = index(dados)))
}
# --- Criar a string de addTA usando os nomes dos objetos ---
fibonacci_lines <- sapply(1:length(retracoes), function(i) {
nome_obj <- gsub("%", "", names(retracoes)[i])
cor_linha <- ifelse(proximos[i], "yellow", "skyblue")
paste0("addTA(", nome_obj, ", on = 1, col = '", cor_linha, "', lty = 3)")
})
# teste inclui fibonacci
# Calcula indicadores diretamente no xts
sma20  <- SMA(Cl(dados[,1:5]), n = 20)
sma50  <- SMA(Cl(dados[,1:5]), n = 50)
rsi14  <- RSI(Cl(dados[,1:5]), n = 14)
macd   <- MACD(Cl(dados[,1:5]), 12, 26, 9)
atr14  <- ATR(HLC(dados[,1:5]), n = 14)
length(sma20)
nrow(dados)
# Adiciona os indicadores ao xts
dados <- cbind(dados, sma20, sma50, rsi14, macd, atr14[,2])
colnames(dados)[(ncol(dados)-5):ncol(dados)] <- c("SMA_20", "SMA_50", "RSI_14", "MACD", "Signal", "ATR")
# Geração dos sinais (com lag para evitar lookahead bias)
sinal_sma <- ifelse(
Lag(dados$SMA_20, 1) < Lag(dados$SMA_50, 1) & dados$SMA_20 > dados$SMA_50,
"COMPRA",
ifelse(
Lag(dados$SMA_20, 1) > Lag(dados$SMA_50, 1) & dados$SMA_20 < dados$SMA_50,
"VENDA",
"NEUTRO"
)
)
sinal_rsi <- ifelse(
dados$RSI_14 < 30, "COMPRA",
ifelse(dados$RSI_14 > 70, "VENDA", "NEUTRO")
)
sinal_macd <- ifelse(
Lag(dados$MACD, 1) < Lag(dados$Signal, 1) & dados$MACD > dados$Signal,
"COMPRA",
ifelse(
Lag(dados$MACD, 1) > Lag(dados$Signal, 1) & dados$MACD < dados$Signal,
"VENDA",
"NEUTRO"
)
)
# Junta os sinais ao xts como fatores
dados$sinal_sma   <- as.factor(sinal_sma)
dados$sinal_rsi   <- as.factor(sinal_rsi)
dados$sinal_macd  <- as.factor(sinal_macd)
# Combina sinais em uma coluna final
sinal_final <- ifelse(
sinal_sma == "COMPRA" & sinal_rsi == "COMPRA" & sinal_macd == "COMPRA", "COMPRA_FORTE",
ifelse(sinal_sma == "VENDA" & sinal_rsi == "VENDA" & sinal_macd == "VENDA", "VENDA_FORTE",
ifelse(sinal_sma == "COMPRA" | sinal_rsi == "COMPRA" | sinal_macd == "COMPRA", "COMPRA",
ifelse(sinal_sma == "VENDA" | sinal_rsi == "VENDA" | sinal_macd == "VENDA", "VENDA", "NEUTRO")
)
)
)
dados$sinal_final <- as.factor(sinal_final)
tail(dados)
rownames(dados) =  index(dados)
sinais_ativos = rbind(sinais_ativos, data.frame(ativo=at, sinal = tail(sinal_final[,1],1)))
grafico3 =  tabela_VALE3b %>%
ggplot(aes(x = index, y = Close, open = Open,
high = High, low = Low, close = Close, volume = Volume)) +
geom_segment(aes(x = CodigoIdentificadorNegocio,
xend = CodigoIdentificadorNegocio,
y = min(Close) ,
yend = volumeR2,
color = cor),
size = max(0.5, largura_coluna)) +  # Define o tamanho das colunas
scale_color_identity() +
geom_candlestick(colour_up = "lightblue"
, colour_down = "lightsalmon"
, fill_up = "skyblue"
, fill_down = "lightsalmon"
, width = largura_coluna_candlestick) +
# Média móvel
geom_line(aes(y = media_movel),
color = "green",
linetype = "solid",
linewidth = 0.3, na.rm = TRUE) +
# Média volume
geom_line(aes(y = volumeR2Medio),
color = "gray",
linetype = "solid",
linewidth = 0.3, na.rm = TRUE) +
geom_line(aes(y = Fibo_23.6[,1] ),
color = "gray",
linetype = "dotted",
linewidth = 0.3, na.rm = TRUE) +
geom_line(aes(y = Fibo_38.2[,1] ),
color = "gray",
linetype = "dotted",
linewidth = 0.3, na.rm = TRUE) +
geom_line(aes(y = Fibo_50[,1] ),
color = "skyblue",
linetype = "solid",
