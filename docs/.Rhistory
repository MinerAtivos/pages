# --- Configurações ---
# Substitua pelo caminho completo para o seu diretório do projeto local
projeto_local <- "C:\\Lucas\\Git\\pages\\docs"
# Substitua pela sua mensagem de commit (descreva as suas mudanças)
mensagem_commit <- "Atualização via script R"
# Substitua pelo nome da sua branch principal (geralmente 'main' ou 'master')
branch_principal <- "main"
# --- Navegar para o diretório do projeto ---
setwd(projeto_local)
cat("Navegando para o diretório:", getwd(), "\n")
# 3. Puxar as últimas mudanças do repositório remoto (GitHub)
# Isso é importante para evitar conflitos se houver mudanças no GitHub que você não tem localmente.
cat("\nPuxando as últimas mudanças do GitHub...\n")
system(paste0("git pull origin ", branch_principal))
# 4. Enviar (push) as suas mudanças locais para o repositório remoto (GitHub)
cat("\nEnviando mudanças para o GitHub...\n")
system(paste0("git push origin ", branch_principal))
cat("\n--- Sincronização concluída! ---\n")
