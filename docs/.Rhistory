Name = variable_name,
VariableType = variable_type,
IsBuiltIn = is_built_in,
Parameters = params_str
)
})) %>%
select(Type, ID, Name, VariableType, IsBuiltIn, Parameters)
} else {
message("Nenhuma variável encontrada no arquivo JSON.")
}
# --- Variáveis Built-In ---
built_in_variables_raw <- gtm_data$containerVersion$builtInVariable
built_in_variables_df <- tibble()
if (!is.null(built_in_variables_raw) && length(built_in_variables_raw) > 0) {
built_in_variables_df <- bind_rows(lapply(built_in_variables_raw, function(bv) {
tibble(
Type = "Variável Built-In",
ID = NA_character_, # Built-ins não têm ID numérico direto no export
Name = bv$name %||% NA_character_,
VariableType = bv$type %||% NA_character_,
IsBuiltIn = TRUE,
Parameters = NA_character_
)
})) %>%
select(Type, ID, Name, VariableType, IsBuiltIn, Parameters)
} else {
message("Nenhuma variável Built-In encontrada no arquivo JSON.")
}
# --- Organização Relacional e Hierárquica ---
# Mapear IDs para Nomes para facilitar a leitura
trigger_id_to_name <- setNames(triggers_df$Name, triggers_df$ID)
# Adicionar Nomes dos Gatilhos às Tags
tags_relational_df <- tags_df %>%
mutate(
FiringTriggers_Names = sapply(strsplit(FiringTriggers_IDs, ", "), function(ids) {
if (length(ids) == 1 && ids == "") return(NA_character_)
paste(trigger_id_to_name[ids], collapse = ", ")
}),
BlockingTriggers_Names = sapply(strsplit(BlockingTriggers_IDs, ", "), function(ids) {
if (length(ids) == 1 && ids == "") return(NA_character_)
paste(trigger_id_to_name[ids], collapse = ", ")
}),
# NOVA LÓGICA: Criação da coluna 'Nome de Evento Consolidado'
`Nome de Evento Consolidado` = mapply(function(event_spec_tag, tag_name) {
if (!is.na(event_spec_tag) && grepl("eventName:", event_spec_tag)) {
# Extrai o valor após 'eventName: '
return(gsub(".*eventName: ([^,]+).*", "\\1", event_spec_tag))
} else if (!is.na(event_spec_tag) && grepl("customEventName:", event_spec_tag)) {
# Extrai o valor após 'customEventName: '
return(gsub(".*customEventName: ([^,]+).*", "\\1", event_spec_tag))
} else {
return(tag_name) # Retorna o nome da tag se nenhum dos outros for encontrado
}
}, `Eventos Específicos da Tag`, Name, SIMPLIFY = TRUE)
) %>%
# Incluir a nova coluna 'Nome de Evento Consolidado' e ajustar a ordem
select(Type, ID, Name, `Nome de Evento Consolidado`, `Eventos Específicos da Tag`, TagType, Status, FiringTriggers_IDs, FiringTriggers_Names,
BlockingTriggers_IDs, BlockingTriggers_Names, Parameters, Notes)
# --- Detecção de Elementos Não Utilizados/Pausados ---
# Tags Pausadas
paused_tags_df <- tags_df %>%
filter(Status == "Pausada") %>%
select(Type, Name, TagType, Status, Notes)
# Gatilhos Não Utilizados (não referenciados por nenhuma tag)
used_trigger_ids <- unique(c(
unlist(strsplit(tags_df$FiringTriggers_IDs, ", ")),
unlist(strsplit(tags_df$BlockingTriggers_IDs, ", "))
))
used_trigger_ids <- used_trigger_ids[used_trigger_ids != ""] # Remover vazios
unused_triggers_df <- triggers_df %>%
filter(!ID %in% used_trigger_ids) %>%
select(Type, Name, TriggerType)
# Nomes de variáveis customizadas
custom_variable_names <- variables_df %>%
filter(!IsBuiltIn) %>%
pull(Name)
# Coletar todos os nomes de variáveis (personalizadas e built-in) para lookup
all_variable_names_for_lookup <- c(
variables_df$Name,
built_in_variables_df$Name
) %>% unique()
unused_custom_variables_df <- variables_df %>%
filter(!IsBuiltIn) %>% # Focar apenas nas variáveis customizadas
mutate(
IsReferencedInTagsOrVars = sapply(Name, function(var_name) {
any(grepl(paste0("\\{\\{", var_name, "\\}\\}"), c(tags_df$Parameters, variables_df$Parameters), fixed = FALSE))
})
) %>%
filter(!IsReferencedInTagsOrVars) %>%
select(Type, Name, VariableType)
# --- Criar a nova planilha: Relação de Gatilhos e Variáveis por Tag ---
tag_component_list <- list()
# Mapeamento de IDs de gatilhos de evento personalizados para seus nomes de evento
custom_event_trigger_id_to_name <- triggers_df %>%
filter(TriggerType == "CUSTOM_EVENT") %>%
select(ID, CustomEventName) %>%
# Garantir que apenas entradas com CustomEventName válido sejam incluídas
filter(!is.na(CustomEventName) & nchar(CustomEventName) > 0) %>%
tibble::deframe() # Converte para um vetor nomeado (ID -> CustomEventName)
if (nrow(tags_relational_df) > 0) {
for (i in 1:nrow(tags_relational_df)) {
tag_row <- tags_relational_df[i, ]
tag_name <- tag_row$Name %||% NA_character_
tag_type <- tag_row$TagType %||% NA_character_
tag_status <- tag_row$Status %||% NA_character_
firing_triggers <- tag_row$FiringTriggers_Names %||% NA_character_
blocking_triggers <- tag_row$BlockingTriggers_Names %||% NA_character_
# Extrair variáveis utilizadas nos parâmetros da tag
tag_params_str <- tag_row$Parameters %||% ""
used_variables_in_params <- find_variable_references_gtm(tag_params_str, all_variable_names_for_lookup)
# Formatar variáveis utilizadas para o relatório
formatted_used_variables <- if (length(used_variables_in_params) > 0) {
paste(sort(used_variables_in_params), collapse = ", ")
} else {
NA_character_
}
# Extrair nomes de eventos dos gatilhos de disparo (para a aba 'Relacao Tag-Gatilho-Variavel')
current_firing_trigger_ids <- unlist(strsplit(tag_row$FiringTriggers_IDs %||% "", ", "))
current_firing_trigger_ids <- current_firing_trigger_ids[current_firing_trigger_ids != ""]
event_names_for_tag <- character(0)
if (length(current_firing_trigger_ids) > 0) {
for (trigger_id in current_firing_trigger_ids) {
# Verificar se o ID do gatilho existe no mapeamento de eventos personalizados
if (trigger_id %in% names(custom_event_trigger_id_to_name)) {
event_name <- custom_event_trigger_id_to_name[[trigger_id]]
# Adicionar apenas nomes de eventos válidos (não NA e não vazios)
if (!is.na(event_name) && nchar(event_name) > 0) {
event_names_for_tag <- c(event_names_for_tag, event_name)
}
}
}
}
formatted_event_names <- if (length(event_names_for_tag) > 0) {
paste(sort(unique(event_names_for_tag)), collapse = ", ")
} else {
NA_character_
}
tag_component_list[[i]] <- tibble(
`Nome da Tag` = tag_name,
`Tipo da Tag` = tag_type,
`Status da Tag` = tag_status,
`Gatilhos de Disparo` = firing_triggers,
`Gatilhos de Bloqueio` = blocking_triggers,
`Nomes dos Eventos` = formatted_event_names, # Coluna com nomes dos eventos para esta aba
`Variáveis Utilizadas nos Parâmetros` = formatted_used_variables
)
}
tag_components_df <- bind_rows(tag_component_list)
} else {
tag_components_df <- tibble(
`Nome da Tag` = character(),
`Tipo da Tag` = character(),
`Status da Tag` = character(),
`Gatilhos de Disparo` = character(),
`Gatilhos de Bloqueio` = character(),
`Nomes dos Eventos` = character(), # Coluna com nomes dos eventos para esta aba
`Variáveis Utilizadas nos Parâmetros` = character()
)
}
# --- 3. FORNECER UM RELATÓRIO DETALHADO EM EXCEL ---
# Criar um objeto workbook
wb <- createWorkbook()
# Adicionar abas ao Excel
addWorksheet(wb, "Visão Geral do Container")
addWorksheet(wb, "Tags")
addWorksheet(wb, "Gatilhos")
addWorksheet(wb, "Variaveis Personalizadas")
addWorksheet(wb, "Variaveis Built-In")
addWorksheet(wb, "Tags Pausadas")
addWorksheet(wb, "Gatilhos Nao Utilizados")
addWorksheet(wb, "Variaveis Nao Utilizadas")
addWorksheet(wb, "Relacao Tag-Gatilho-Variavel")
# --- Escrever dados nas abas ---
# Visão Geral
container_summary_df <- tibble(
Item = c("Nome do Contêiner", "ID do Contêiner", "Data de Exportação",
"Total de Tags", "Total de Gatilhos", "Total de Variáveis Personalizadas",
"Total de Variáveis Built-In", "Tags Pausadas",
"Gatilhos Não Utilizados", "Variáveis Personalizadas Não Utilizadas"),
Valor = c(container_name, container_id, export_time,
nrow(tags_df), nrow(triggers_df), nrow(variables_df %>% filter(!IsBuiltIn)),
nrow(built_in_variables_df), nrow(paused_tags_df),
nrow(unused_triggers_df), nrow(unused_custom_variables_df))
)
writeData(wb, "Visão Geral do Container", container_summary_df)
# Tags (agora com a nova coluna 'Eventos Específicos da Tag' e 'Nome de Evento Consolidado')
if (nrow(tags_relational_df) > 0) {
writeData(wb, "Tags", tags_relational_df, headerStyle = createStyle(textDecoration = "bold", fgFill = "#DCE6F1"))
# Ajustar largura das colunas
setColWidths(wb, "Tags", cols = 1:ncol(tags_relational_df), widths = "auto")
} else {
writeData(wb, "Tags", "Nenhuma tag encontrada.")
}
# Gatilhos (agora com a nova coluna 'Filtros/Condições')
if (nrow(triggers_df) > 0) {
writeData(wb, "Gatilhos", triggers_df, headerStyle = createStyle(textDecoration = "bold", fgFill = "#DCE6F1"))
setColWidths(wb, "Gatilhos", cols = 1:ncol(triggers_df), widths = "auto")
} else {
writeData(wb, "Gatilhos", "Nenhum gatilho encontrado.")
}
# Variáveis Personalizadas
if (nrow(variables_df %>% filter(!IsBuiltIn)) > 0) {
writeData(wb, "Variaveis Personalizadas", variables_df %>% filter(!IsBuiltIn), headerStyle = createStyle(textDecoration = "bold", fgFill = "#DCE6F1"))
setColWidths(wb, "Variaveis Personalizadas", cols = 1:ncol(variables_df), widths = "auto")
} else {
writeData(wb, "Variaveis Personalizadas", "Nenhuma variável personalizada encontrada.")
}
# Variáveis Built-In
if (nrow(built_in_variables_df) > 0) {
writeData(wb, "Variaveis Built-In", built_in_variables_df, headerStyle = createStyle(textDecoration = "bold", fgFill = "#DCE6F1"))
setColWidths(wb, "Variaveis Built-In", cols = 1:ncol(built_in_variables_df), widths = "auto")
} else {
writeData(wb, "Variaveis Built-In", "Nenhuma variável Built-In encontrada.")
}
# Tags Pausadas
if (nrow(paused_tags_df) > 0) {
writeData(wb, "Tags Pausadas", paused_tags_df, headerStyle = createStyle(textDecoration = "bold", fgFill = "#FFCC00"))
setColWidths(wb, "Tags Pausadas", cols = 1:ncol(paused_tags_df), widths = "auto")
} else {
writeData(wb, "Tags Pausadas", "Nenhuma tag pausada encontrada.")
}
# Gatilhos Não Utilizados
if (nrow(unused_triggers_df) > 0) {
writeData(wb, "Gatilhos Nao Utilizados", unused_triggers_df, headerStyle = createStyle(textDecoration = "bold", fgFill = "#FF9999"))
setColWidths(wb, "Gatilhos Nao Utilizados", cols = 1:ncol(unused_triggers_df), widths = "auto")
} else {
writeData(wb, "Gatilhos Nao Utilizados", "Nenhum gatilho não utilizado encontrado.")
}
# Variáveis Não Utilizadas
if (nrow(unused_custom_variables_df) > 0) {
writeData(wb, "Variaveis Nao Utilizadas", unused_custom_variables_df, headerStyle = createStyle(textDecoration = "bold", fgFill = "#FF9999"))
setColWidths(wb, "Variaveis Nao Utilizadas", cols = 1:ncol(unused_custom_variables_df), widths = "auto")
} else {
writeData(wb, "Variaveis Nao Utilizadas", "Nenhuma variável personalizada não utilizada encontrada.")
}
# ABA: Relação Tag-Gatilho-Variavel
if (nrow(tag_components_df) > 0) {
writeData(wb, "Relacao Tag-Gatilho-Variavel", tag_components_df, headerStyle = createStyle(textDecoration = "bold", fgFill = "#C6E0B4")) # Cabeçalho verde claro
setColWidths(wb, "Relacao Tag-Gatilho-Variavel", cols = 1:ncol(tag_components_df), widths = "auto")
} else {
writeData(wb, "Relacao Tag-Gatilho-Variavel", "Nenhuma tag encontrada para gerar a relação completa.")
}
# Salvar o arquivo Excel
saveWorkbook(wb, output_excel_file, overwrite = TRUE)
cat(paste0("\nRelatório gerado com sucesso em: ", output_excel_file, "\n"))
cat(paste0("Coluna 'Nome de Evento Consolidado' adicionada à aba 'Tags' com base nas suas regras.\n"))
cat(paste0("Coluna 'Eventos Específicos da Tag' na aba 'Tags' e 'Filtros/Condições' na aba 'Gatilhos' também foram aprimoradas.\n"))
